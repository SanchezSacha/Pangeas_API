# Application
NODE_ENV=development
PORT=3000
SESSION_SECRET=change_me_with_a_long_random_secret

# MySQL Docker
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=pangeas
MYSQL_USER=pangeas
MYSQL_PASSWORD=pangeas
MYSQL_ROOT_PASSWORD=root

# Prisma
DATABASE_URL="mysql://pangeas:pangeas@localhost:3306/pangeas"
SHADOW_DATABASE_URL="mysql://root:root@localhost:3306/pangeas_shadow"

# MongoDB
MONGO_URI="mongodb://localhost:27017"
MONGO_DB_NAME=Pangeas
