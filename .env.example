# Application
NODE_ENV=development
PORT=3000
SESSION_SECRET=change_me_with_a_long_random_secret
SESSION_COOKIE_NAME=pangeas.sid
SESSION_MAX_AGE_MS=7200000
SESSION_SAME_SITE=lax
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:4173
# Vide = tous les hôtes HTTPS. En production, renseigner une liste séparée par des virgules.
PLACE_IMAGE_ALLOWED_HOSTS=

# MySQL Docker
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=pangeas
MYSQL_USER=pangeas
MYSQL_PASSWORD=pangeas
MYSQL_ROOT_PASSWORD=root

# Prisma
DATABASE_URL="mysql://pangeas:pangeas@localhost:3306/pangeas"
SHADOW_DATABASE_URL="mysql://root:root@localhost:3306/pangeas_shadow"

# MongoDB
MONGO_URI="mongodb://localhost:27017"
MONGO_DB_NAME=Pangeas

# Email SMTP (Brevo gratuit conseille : host smtp-relay.brevo.com, port 587)
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your_brevo_smtp_login
MAIL_PASSWORD=your_brevo_smtp_key
MAIL_FROM="Pangeas <no-reply@your-domain.com>"
FRONTEND_RESET_PASSWORD_URL=http://localhost:5173/reset-password
