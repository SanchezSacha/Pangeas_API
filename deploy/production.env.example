# Ce modele est transforme automatiquement par le script au premier deploiement.
# Les marqueurs ci-dessous sont remplaces par des secrets aleatoires sur le serveur.

NODE_ENV=production
PORT=3000

# Session
# Generation conseillee : openssl rand -hex 32
SESSION_SECRET=GENERATE_SESSION_SECRET
SESSION_COOKIE_NAME=pangeas.sid
SESSION_MAX_AGE_MS=7200000
SESSION_SAME_SITE=lax

# URL publique
FRONTEND_ORIGINS=https://pangeas.example.fr
FRONTEND_RESET_PASSWORD_URL=https://pangeas.example.fr/reset-password

# Restreindre aux domaines HTTPS reellement utilises par les images des lieux.
PLACE_IMAGE_ALLOWED_HOSTS=

# MySQL Docker
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=pangeas
MYSQL_USER=pangeas
MYSQL_PASSWORD=GENERATE_MYSQL_PASSWORD
MYSQL_ROOT_PASSWORD=GENERATE_MYSQL_ROOT_PASSWORD
DATABASE_URL=mysql://pangeas:GENERATE_MYSQL_PASSWORD@127.0.0.1:3306/pangeas

# MongoDB Docker
MONGO_PORT=27017
MONGO_ROOT_USER=pangeas_admin
MONGO_ROOT_PASSWORD=GENERATE_MONGO_PASSWORD
MONGO_URI=mongodb://pangeas_admin:GENERATE_MONGO_PASSWORD@127.0.0.1:27017/?authSource=admin
MONGO_DB_NAME=Pangeas

# Service SMTP
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=b1c213001@smtp-brevo.com
MAIL_PASSWORD=
MAIL_FROM=Pangeas <sanchezsacha2002@gmail.com>
